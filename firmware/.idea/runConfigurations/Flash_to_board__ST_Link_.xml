<?xml version="1.0" encoding="UTF-8"?>
<!--
  CLion run configuration: flash the firmware to the board over ST-Link.

  字段名已按 CLion 2026.2 的 com.intellij.sh.run.ShRunConfiguration 核对:
    SCRIPT_TEXT / SCRIPT_PATH / SCRIPT_OPTIONS / SCRIPT_WORKING_DIRECTORY
    INTERPRETER_PATH / INTERPRETER_OPTIONS / EXECUTE_SCRIPT_FILE / EXECUTE_IN_TERMINAL
  (此前误写的 INDEPENDENT_* 在插件里并不存在, 已删除)

  如果这个配置没有自动出现, 手工添加 (约 20 秒):
    Run -> Edit Configurations -> + -> Shell Script
      Name             : Flash to board (ST-Link)
      Interpreter path : powershell.exe
      Interpreter opts : -ExecutionPolicy Bypass -File
      Script path      : $PROJECT_DIR$/../flash.ps1
      Script options   : -Config Debug
      Working dir      : $PROJECT_DIR$
      [x] Execute in terminal

  重要: 本工程的 AntiTerrorRobot 是 ARM 固件, 不能用 CLion 默认的 Application
  配置运行 (会报 CreateProcess error=193)。编译用 Build (Ctrl+F9), 下载用这个配置
  或者 CLion 原生的 ST-LINK 调试配置。
-->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Flash to board (ST-Link)" type="ShConfigurationType">
    <option name="SCRIPT_TEXT" value="" />
    <option name="SCRIPT_PATH" value="$PROJECT_DIR$/../flash.ps1" />
    <option name="SCRIPT_OPTIONS" value="-Config Debug" />
    <option name="SCRIPT_WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <option name="INTERPRETER_PATH" value="powershell.exe" />
    <option name="INTERPRETER_OPTIONS" value="-ExecutionPolicy Bypass -File" />
    <option name="EXECUTE_SCRIPT_FILE" value="true" />
    <option name="EXECUTE_IN_TERMINAL" value="true" />
    <envs />
    <method v="2" />
  </configuration>
</component>
